{
  "name": "mathbattles",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @mathbattles/client",
    "dev:server": "npm run dev -w @mathbattles/server",
    "build": "npm run build -w @mathbattles/client",
    "test": "vitest run",
    "typecheck": "tsc -p packages/sim --noEmit && tsc -p apps/client --noEmit && tsc -p apps/server --noEmit",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.3"
  }
}
